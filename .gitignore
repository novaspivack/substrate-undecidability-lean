# See NOTES/PROJECT_SEED.md §7.1–§7.2 (gitignore policy + Git LFS for large files).

# OS
.DS_Store
Thumbs.db

# Editors / IDE
.idea/
# Commit shared VS Code defaults (linter scope); ignore personal launch/tasks
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
*.swp
*.swo
*~

# Private keys (do not commit)
*.pem

# Logs
*.log
logs/

# Caches (exclude noisy cache dirs; do not blanket-ignore *.json — see PROJECT_SEED §7.1)
.cache/

# Lean
.lake/
build/
*.olean
*.ilean
*.trace

# Python (if used later)
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/

# Node (if used later)
node_modules/
npm-debug.log*
yarn-error.log*

# Build outputs (stack-specific — extend per project)
dist/
build/
*.egg-info/

# ---------------------------------------------------------------------------
# Internal agent/process material — never surfaces publicly
#
# This repo is heading toward a public GitHub release. Everything below is
# agent-methodology / development-process scaffolding (specs, queues, team
# prompts, internal coding protocols, agent rule files) — never the public
# deliverable itself (that is Substrate/, Substrate.lean, lakefile.lean,
# lean-toolchain, lake-manifest.json, paper/, README.md, LICENSE).
#
# Untracked going forward via `git rm --cached` (files remain on disk for
# internal agent use — only git no longer tracks them). Mode B, applied
# retroactively; see history-exposure caveat in the removal commit message.
specs/
NOTES/
work-notes/
docs/
.cursor/
.cursorrules
AGENTS.md
CODING_PROTOCOLS.md
MANIFEST.md
PROJECT_SEED.md
QUEUE.md
THE_GENIUS_TEAM_PROMPT.md

# Leftover generic-template Python tooling config — irrelevant to this
# pure-Lean repo (no Python anywhere in the tree); noise from the project
# scaffold, not a real project dependency.
pyrightconfig.json

# Internal agent scratch space (currently empty; ignored so future scratch
# content is never accidentally committed).
scratch/

# ---------------------------------------------------------------------------
# LaTeX build byproducts (paper/) — regenerated by the build, not source.
*.aux
*.bbl
*.blg
*.out
*.toc
*.synctex.gz
*.fls
*.fdb_latexmk

